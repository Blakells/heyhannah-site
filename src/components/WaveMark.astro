---
interface Props {
  width?: number;
  height?: number;
}
const { width = 27, height = 19 } = Astro.props;
---
<svg
  class="wave-mark"
  width={width}
  height={height}
  viewBox="0 0 27 19"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <path
    d="M1 12c2.7-4.8 5.4-4.8 8.1 0s5.4 4.8 8.1 0 5.4-4.8 8.1 0"
    stroke="currentColor"
    stroke-width="1.9"
    stroke-linecap="round"></path>
  <path
    d="M2.7 5.6c2.1-3.6 4.2-3.6 6.3 0s4.2 3.6 6.3 0 4.2-3.6 6.3 0"
    stroke="currentColor"
    stroke-width="1.4"
    stroke-linecap="round"
    opacity=".5"></path>
</svg>
