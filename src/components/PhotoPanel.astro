---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  alt: string;
  title: string;
  description: string;
  /** An optional link below the text. */
  link?: { href: string; label: string };
  /** Which part of the photo to keep in the crop. */
  focus?: 'center' | 'low' | 'high';
  /** The image's intrinsic size, used to reserve space. */
  width: number;
  height: number;
}
const { image, alt, title, description, link, focus = 'center', width, height } = Astro.props;
---
<article class="panel">
  <div class="panel-ph">
    <Image class:list={['panel-img', `focus-${focus}`]} src={image} alt={alt} width={width} height={height} />
  </div>
  <div class="panel-body">
    <h3>{title}</h3>
    <p>{description}</p>
    {
      link && (
        <a class="panel-link" href={link.href}>
          {link.label} <span class="arrow" aria-hidden="true">→</span>
        </a>
      )
    }
  </div>
</article>

<style>
  .panel {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: var(--paper);
    border: 1px solid var(--rule);
    border-radius: var(--radius-card);
    box-shadow: 0 26px 46px -44px rgba(8, 54, 61, 0.55);
  }
  .panel-ph {
    aspect-ratio: 5 / 4;
    overflow: hidden;
    background: var(--sand-3);
  }
  .panel-ph :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.3, 1);
  }
  .panel-ph :global(.focus-low) {
    object-position: 50% 60%;
  }
  .panel-ph :global(.focus-high) {
    object-position: 50% 30%;
  }
  .panel:hover .panel-ph :global(img) {
    transform: scale(1.04);
  }
  .panel-body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: clamp(20px, 2.6vw, 28px);
  }
  .panel-body h3 {
    font-size: 1.4rem;
    line-height: 1.18;
    letter-spacing: -0.018em;
    font-weight: 600;
  }
  .panel-body p {
    margin-top: 10px;
    max-width: 44ch;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--ink-2);
    text-wrap: pretty;
  }
  .panel-link {
    margin-top: 18px;
    padding-top: 2px;
  }
</style>
